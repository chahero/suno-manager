# SUNO API Configuration
# SUNO Bearer Token (JWT)
# Enter the token on the web login page, or enter it directly below
# SUNO_BEARER_TOKEN=your_token_here

# (Optional) Device ID - Auto-generated if not set
# SUNO_DEVICE_ID=2771cc4f-fbb1-43f7-b32a-ca1deb4c38dc

# Flask Configuration
SECRET_KEY=your_secret_key_here_change_in_production
PORT=5000
DEBUG=True

# Download Configuration
# Folder path where downloaded music files will be saved
# Both relative and absolute paths are supported
DOWNLOAD_FOLDER=downloads

# =====================================================
# How to get Bearer Token:
# =====================================================
# 1. Log in to https://suno.com
# 2. Open browser developer tools (F12)
# 3. Go to Network tab
# 4. Refresh the page (F5)
# 5. Click on 'feed/v3' request
# 6. Find 'authorization' header in Request Headers
# 7. Copy only the token after 'Bearer ' (e.g., eyJhbGciOiJSUzI1NiIs...)
# 8. Paste it in SUNO_BEARER_TOKEN above
#
# Note: Bearer tokens expire approximately every hour.
# If you get a 401 error, fetch a new token.
