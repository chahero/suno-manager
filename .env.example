# SUNO API Configuration
# SUNO Bearer 토큰 (JWT)
# 웹 로그인 페이지에서 토큰을 입력하거나, 아래에 직접 입력하세요
# SUNO_BEARER_TOKEN=여기에_토큰_입력

# (선택사항) 디바이스 ID - 설정하지 않으면 자동 생성됨
# SUNO_DEVICE_ID=2771cc4f-fbb1-43f7-b32a-ca1deb4c38dc

# Flask Configuration
SECRET_KEY=your_secret_key_here_change_in_production
PORT=5000
DEBUG=True

# Download Configuration
# 다운로드된 음악 파일이 저장될 폴더 경로
# 상대 경로 또는 절대 경로 모두 가능
DOWNLOAD_FOLDER=downloads

# =====================================================
# Bearer 토큰 가져오기:
# =====================================================
# 1. https://suno.com 에 로그인
# 2. 브라우저 개발자 도구 (F12) 열기
# 3. Application 탭 → Cookies → https://suno.com
# 4. __session 쿠키 값 복사
# 5. 웹 로그인 페이지에서 입력하거나, 위 SUNO_BEARER_TOKEN에 붙여넣기
