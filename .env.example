# SUNO API Configuration
# =====================================================
# 옵션 1: 브라우저 쿠키에서 자동으로 읽기 (권장)
# =====================================================
# Chrome, Edge, Firefox 등 브라우저에 suno.com에 로그인만 하면
# 자동으로 쿠키에서 토큰을 읽어옵니다.
#
# 필요 패키지: pip install browser-cookie3
# SUNO_BEARER_TOKEN을 비워두면 자동으로 브라우저 쿠키에서 읽습니다.

# =====================================================
# 옵션 2: 수동으로 Bearer 토큰 입력
# =====================================================
# 브라우저 쿠키 사용을 원하지 않으면 아래에 직접 토큰을 입력하세요.
# SUNO_BEARER_TOKEN=여기에_토큰_입력

# (선택사항) 디바이스 ID - 설정하지 않으면 자동 생성됨
# SUNO_DEVICE_ID=2771cc4f-fbb1-43f7-b32a-ca1deb4c38dc

# Flask Configuration
SECRET_KEY=your_secret_key_here_change_in_production
PORT=5000
DEBUG=True

# Download Configuration
# 다운로드된 음악 파일이 저장될 폴더 경로
# 상대 경로 또는 절대 경로 모두 가능
DOWNLOAD_FOLDER=downloads

# =====================================================
# Bearer 토큰 수동으로 가져오기 (옵션 2를 선택한 경우):
# =====================================================
# 방법 1: 브라우저 개발자 도구 사용
#   1. https://suno.com 에 로그인
#   2. 브라우저 개발자 도구 (F12) 열기
#   3. Network 탭 선택
#   4. 페이지 새로고침 (F5)
#   5. 요청 목록에서 'feed' 또는 'api'로 시작하는 요청 클릭
#   6. Request Headers에서 'authorization' 찾기
#   7. "Bearer eyJ..." 값에서 'Bearer ' 이후의 토큰만 복사
#   8. 위 SUNO_BEARER_TOKEN에 붙여넣기
#
# 방법 2: 브라우저 쿠키에서 직접 복사
#   1. https://suno.com 에 로그인
#   2. 브라우저 개발자 도구 (F12) 열기
#   3. Application (또는 Storage) 탭 선택
#   4. Cookies > https://suno.com 선택
#   5. __session 또는 __session_로 시작하는 쿠키 찾기
#   6. 값을 복사하여 위 SUNO_BEARER_TOKEN에 붙여넣기
#
# 또는 웹 로그인 페이지에서 직접 입력하세요!
