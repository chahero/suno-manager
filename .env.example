# SUNO API Configuration
# SUNO 세션 토큰 (브라우저에서 로그인 후 쿠키에서 'token' 값 복사)
# 또는 로그인 페이지에서 토큰을 입력하세요
SUNO_SESSION_TOKEN=your_suno_session_token_here

# Flask Configuration
SECRET_KEY=your_secret_key_here_change_in_production
FLASK_ENV=development

# 토큰 가져오기:
# 1. https://suno.com 에 로그인
# 2. 브라우저 개발자 도구 (F12) 열기
# 3. Application/Storage → Cookies → https://suno.com
# 4. 'token' 쿠키 값 복사
# 5. 위 SUNO_SESSION_TOKEN에 붙여넣기
